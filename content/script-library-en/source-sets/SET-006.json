          "slide_number": 7,
          "slide_label": "Slide 7",
          "is_metafi_slide": false,
          "text": "• Fri speed run\n• Sat full body\n• Sun long run"
        },
        {
          "slide_number": 8,
          "slide_label": "Slide 8",
          "is_metafi_slide": false,
          "text": "biggest thing: don't put leg day right before a speed run or long run."
        },
        {
          "slide_number": 9,
          "slide_label": "Slide 9",
          "is_metafi_slide": false,
          "text": "and on leg day, don't overdo it or go to failure every set. save some energy for your running."
        }
