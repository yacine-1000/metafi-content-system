      "slides": [
        {
          "slide_number": 1,
          "slide_label": "Slide 1",
          "is_metafi_slide": false,
          "text": "what does RPE actually mean?"
        },
        {
          "slide_number": 2,
          "slide_label": "Slide 2",
          "is_metafi_slide": false,
          "text": "save this. you'll need it at the gym"
        },
        {
          "slide_number": 3,
          "slide_label": "Slide 3",
          "is_metafi_slide": false,
          "text": "it's a number that tells you how hard the set actually felt. from 1 to 10, easy to your absolute max."
        },
        {
          "slide_number": 4,
          "slide_label": "Slide 4",
          "is_metafi_slide": false,
          "text": "quick example: finished the set and could still crank out a bunch more reps = low RPE. two reps left in the tank = RPE 8ish."
        },
        {
          "slide_number": 5,
          "slide_label": "Slide 5",
          "is_metafi_slide": true,
          "text": "get a lifting plan that actually adjusts to your week and your goal\ntry the app"
        },
        {
          "slide_number": 6,
          "slide_label": "Slide 6",
          "is_metafi_slide": false,
          "text": "can't add a single rep = RPE 10."
        },
        {
          "slide_number": 7,
          "slide_label": "Slide 7",
          "is_metafi_slide": false,
          "text": "why does RPE matter? it tells you when to add weight, when to back off, and when your body needs rest."
        },
        {
          "slide_number": 8,
          "slide_label": "Slide 8",
          "is_metafi_slide": false,
          "text": "bottom line: RPE lets you train smart. you don't need to destroy yourself every single day."
        }
      ]
    },
