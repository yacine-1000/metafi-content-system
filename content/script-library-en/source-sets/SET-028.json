      "slides": [
        {
          "slide_number": 1,
          "slide_label": "Slide 1",
          "is_metafi_slide": false,
          "text": "do pilates and lift? here's the split"
        },
        {
          "slide_number": 2,
          "slide_label": "Slide 2",
          "is_metafi_slide": false,
          "text": "save this. you'll need it at the gym"
        },
        {
          "slide_number": 3,
          "slide_label": "Slide 3",
          "is_metafi_slide": false,
          "text": "Monday. lifting (upper body). focus: back, shoulders, chest, arms. prioritize form before adding weight."
        },
        {
          "slide_number": 4,
          "slide_label": "Slide 4",
          "is_metafi_slide": false,
          "text": "Tuesday. pilates. focus: flexibility, core, balance, posture."
        },
        {
          "slide_number": 5,
          "slide_label": "Slide 5",
          "is_metafi_slide": true,
          "text": "get a lifting plan that adjusts around your sport\ntry the app"
        },
        {
          "slide_number": 6,
          "slide_label": "Slide 6",
          "is_metafi_slide": false,
          "text": "Wednesday. rest. walk 20-30 min if you can."
        },
        {
          "slide_number": 7,
          "slide_label": "Slide 7",
          "is_metafi_slide": false,
          "text": "Thursday. lifting (lower body). focus: glutes, hamstrings, quads, calves."
        },
        {
          "slide_number": 8,
          "slide_label": "Slide 8",
          "is_metafi_slide": false,
          "text": "Friday. pilates. focus on control through the movement, relax after leg day."
        },
        {
          "slide_number": 9,
          "slide_label": "Slide 9",
          "is_metafi_slide": false,
          "text": "Saturday. rest."
        },
        {
          "slide_number": 10,
          "slide_label": "Slide 10",
          "is_metafi_slide": false,
          "text": "Sunday. light walk or cardio, 20-40 min, or rest if your body needs it."
        }
      ]
    },
