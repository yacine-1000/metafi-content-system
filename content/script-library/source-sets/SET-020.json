      "slides": [
        {
          "slide_number": 1,
          "slide_label": "Slide 1",
          "is_metafi_slide": false,
          "text": "‏الهدف بسيط، خل اللي يركض يشوف عضالتك وخل اللي يضخم ما يقدر يلحقك 😭"
        },
        {
          "slide_number": 2,
          "slide_label": "Slide 2",
          "is_metafi_slide": false,
          "text": "‏تركض ٣ مرات بالأسبوع: جري خفيف، تمارين سرعة، جري طويل"
        },
        {
          "slide_number": 3,
          "slide_label": "Slide 3",
          "is_metafi_slide": false,
          "text": "‏تتمرن نادي ٤ مرات بالأسبوع: علوي، سفلي، دفع، سحب"
        },
        {
          "slide_number": 4,
          "slide_label": "Slide 4 — Metafi",
          "is_metafi_slide": true,
          "text": "برضو سو لك جدول حديد يتعدل حسب رياضاتك\nاستخدم هذا التطبيق"
        },
        {
          "slide_number": 5,
          "slide_label": "Slide 5",
          "is_metafi_slide": false,
          "text": "‏أكلك يكون مرتب: بروتين عالي، دهون كويسة، كارب يعطيك طاقة، وخلك موزون بالأكل"
        },
        {
          "slide_number": 6,
          "slide_label": "Slide 6",
          "is_metafi_slide": false,
          "text": "‏اهتم باستشفاءك: نم ٧ إلى ٨ ساعات، ساونا، ثلج، ريكفري بوتس"
        }
      ]
    },
    {
