        },
        {
          "slide_number": 3,
          "slide_label": "Slide 3",
          "is_metafi_slide": false,
          "text": "١. الترايسبس\nلو تبغى ذراعك يطلع أعرض، اهتم بالترايسبس أكثر من البايسبس."
        },
        {
          "slide_number": 4,
          "slide_label": "Slide 4",
