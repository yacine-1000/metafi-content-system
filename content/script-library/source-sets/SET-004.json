        {
          "slide_number": 1,
          "slide_label": "Slide 1",
          "is_metafi_slide": false,
          "text": "عمرك فكرت ليش وزنك ثابت مع إنك قاطع سكر؟ مسببات ارتفاع الكورتيزول لازم تنتبه منها:"
        },
        {
          "slide_number": 2,
          "slide_label": "Slide 2",
          "is_metafi_slide": false,
          "text": "خله محفوظ عندك بترجع له بالنادي"
        },
        {
          "slide_number": 3,
          "slide_label": "Slide 3",
          "is_metafi_slide": false,
          "text": "‏ما تنام بشكل كافي يزيد الكورتيزول."
        },
        {
          "slide_number": 4,
          "slide_label": "Slide 4",
          "is_metafi_slide": false,
          "text": "‏شرب القهوة يزيد الكورتيزول."
        },
        {
          "slide_number": 5,
          "slide_label": "Slide 5",
          "is_metafi_slide": true,
          "text": "سو لك جدول حديد ذكي يتعدل حسب أسبوعك وهدفك\nاستخدم هذا التطبيق"
        },
        {
          "slide_number": 6,
          "slide_label": "Slide 6",
          "is_metafi_slide": false,
          "text": "‏تصفح وسائل التواصل يزيد الكورتيزول."
        },
        {
          "slide_number": 7,
          "slide_label": "Slide 7",
          "is_metafi_slide": false,
          "text": "‏الكلام السلبي مع النفس يزيد الكورتيزول."
        },
        {
          "slide_number": 8,
          "slide_label": "Slide 8",
          "is_metafi_slide": false,
          "text": "‏الاستعجال طولا اليوم يزيد الكورتيزول."
        }
