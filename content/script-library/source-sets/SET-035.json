      "format": "Listicle",
      "original_slide_count": 5,
      "final_slide_count": 6,
      "slides": [
        {
          "slide_number": 1,
          "slide_label": "Slide 1",
          "is_metafi_slide": false,
          "text": "‏٣ نصائح تساعدك تبني أكتاف عريضة وثالثية الأبعاد"
