          "slide_number": 5,
          "slide_label": "Slide 5",
          "is_metafi_slide": false,
          "text": "‏والأهم من هذا كله، سجل أوزانك في كل تمرين عشان تضمن إنك قاعد تتطور وما تتمرن عشوائي."
        }
