{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "slider_plan_id",
    "selected_hook",
    "body_slide_count",
    "body_slides",
    "body_notes",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "slider_plan_id": { "type": "string" },
    "selected_hook": { "type": "string" },
    "body_slide_count": { "type": "integer", "minimum": 3, "maximum": 4 },
    "body_slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide_number", "slide_role", "slide_text", "text_intent"],
        "additionalProperties": false,
        "properties": {
          "slide_number": { "type": "integer", "minimum": 2 },
          "slide_role": {
            "type": "string",
            "enum": ["build", "tension", "realization"]
          },
          "slide_text": { "type": "string" },
          "text_intent": { "type": "string" }
        }
      }
    },
    "body_notes": { "type": "string" },
    "status": { "type": "string", "enum": ["drafted"] }
  }
}
