{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "slider_plan_id",
    "hook_type",
    "hook_options",
    "selected_hook",
    "selection_reason",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "slider_plan_id": { "type": "string" },
    "hook_type": {
      "type": "string",
      "enum": ["observation", "self_recognition", "tension", "dry_comedic", "pov", "contrarian"]
    },
    "hook_options": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 3,
      "maxItems": 3
    },
    "selected_hook": { "type": "string" },
    "selection_reason": { "type": "string" },
    "status": { "type": "string", "enum": ["drafted"] }
  }
}
