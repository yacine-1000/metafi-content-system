GEMINI_API_KEY=

CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=

BUFFER_API_KEY=

# Hosted persistence. SUPABASE_SERVICE_ROLE_KEY is server-only and must never
# be prefixed with NEXT_PUBLIC_/VITE_ or exposed to browser bundles.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Keep "local" until the server-side repository adapter is implemented.
METAFI_PERSISTENCE_MODE=local

# Object delivery is a separate hosting checkpoint; no files are uploaded by
# this migration. Use server-generated/signed URLs when configured later.
METAFI_ASSET_STORAGE_PROVIDER=local
